---
// "Monte o pijama da família": a cliente escolhe estampa, modelo e quem vai vestir,
// e o pedido já chega organizado no WhatsApp. Menos vai e vem, mais conversão.
import { site } from '../config';

interface Props {
  prints: { name: string; fabric: string }[];
}
const { prints } = Astro.props;

// TODO: confirmar a grade de tamanhos real do ateliê
const sizes = {
  Bebê: ['RN', 'P', 'M', 'G'],
  Criança: ['1', '2', '3', '4', '6', '8', '10', '12', '14', '16'],
  Adulto: ['PP', 'P', 'M', 'G', 'GG', 'XG'],
};
---

<div data-builder data-wa={site.whatsapp} data-sizes={JSON.stringify(sizes)} class="grid gap-6 lg:grid-cols-[1.35fr_1fr]">
  <div class="rounded-[2rem] bg-cream p-6 shadow-[0_30px_60px_-40px_rgb(29_42_36/0.45)] sm:p-10">
    <fieldset>
      <legend class="mb-4 flex items-center gap-3 font-display text-xl"><span class="step-dot">1</span> Escolha a estampa</legend>
      <div class="flex flex-wrap gap-2.5">
        {prints.map((p, i) => (
          <label class="chip">
            <input type="radio" name="estampa" value={p.name} checked={i === 0} class="peer sr-only" />
            <span class={`fabric fabric-${p.fabric} h-6 w-6 shrink-0 rounded-full ring-1 ring-ink/10`}></span>
            <span>{p.name}</span>
          </label>
        ))}
        <label class="chip">
          <input type="radio" name="estampa" value="Quero ver outras opções" class="peer sr-only" />
          <span class="grid h-6 w-6 place-items-center rounded-full bg-paper text-sm">?</span>
          <span>Quero ver outras</span>
        </label>
      </div>
    </fieldset>

    <fieldset class="mt-10">
      <legend class="mb-4 flex items-center gap-3 font-display text-xl"><span class="step-dot">2</span> Modelo</legend>
      <div class="flex flex-wrap gap-2.5">
        {['Longo', 'Curto', 'Ainda não sei'].map((m, i) => (
          <label class="chip">
            <input type="radio" name="modelo" value={m} checked={i === 0} class="peer sr-only" />
            <span>{m}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="mt-10">
      <legend class="mb-1 flex items-center gap-3 font-display text-xl"><span class="step-dot">3</span> Quem vai vestir?</legend>
      <p class="mb-5 pl-11 text-sm text-ink-soft">Não sabe o tamanho? Escolha "Me ajudem" que a gente indica pelas medidas.</p>
      <ul data-people class="space-y-3"></ul>
      <div class="mt-4 flex flex-wrap gap-2.5">
        {Object.keys(sizes).map((k) => (
          <button type="button" data-add={k} class="rounded-full border border-dashed border-ink/30 px-4 py-2 text-sm font-semibold transition-colors hover:border-leaf hover:bg-mint">
            + {k}
          </button>
        ))}
      </div>
    </fieldset>
  </div>

  <!-- Resumo em forma de etiqueta -->
  <aside class="lg:sticky lg:top-24 lg:self-start">
    <div class="relative overflow-hidden rounded-[2rem] bg-leaf p-8 text-cream sm:p-10">
      <p class="font-script text-4xl leading-none text-gold">Seu pedido</p>
      <dl class="mt-6 space-y-3 text-sm">
        <div class="flex justify-between gap-4 border-b border-cream/15 pb-3"><dt class="text-cream/60">Estampa</dt><dd data-sum="estampa" class="text-right font-semibold"></dd></div>
        <div class="flex justify-between gap-4 border-b border-cream/15 pb-3"><dt class="text-cream/60">Modelo</dt><dd data-sum="modelo" class="text-right font-semibold"></dd></div>
      </dl>
      <p class="mt-5 text-xs uppercase tracking-[0.2em] text-cream/60">Peças</p>
      <ul data-sum="pecas" class="mt-3 space-y-1.5 text-sm"></ul>
      <a data-send href="#" target="_blank" rel="noopener" class="btn mt-8 w-full justify-center bg-cream text-leaf hover:bg-gold hover:text-leaf-deep">
        Enviar pedido no WhatsApp
      </a>
      <p class="mt-4 text-center text-xs text-cream/60">Sem compromisso. Você recebe valores e prazo antes de fechar.</p>
    </div>
  </aside>
</div>

<template data-person-tpl>
  <li class="flex flex-wrap items-center gap-3 rounded-2xl bg-paper/60 p-3 pl-4">
    <span data-kind class="w-16 text-sm font-semibold"></span>
    <input data-name type="text" placeholder="Para quem? (opcional)" class="min-w-0 flex-1 rounded-xl border border-ink/10 bg-cream px-3 py-2 text-sm outline-none focus:border-leaf" />
    <select data-size class="rounded-xl border border-ink/10 bg-cream px-3 py-2 text-sm outline-none focus:border-leaf" aria-label="Tamanho"></select>
    <button type="button" data-remove class="grid h-9 w-9 place-items-center rounded-full text-lg text-ink-soft hover:bg-cream" aria-label="Remover">×</button>
  </li>
</template>

<style>
  .chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
    align-items: center;
    gap: 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(29 42 36 / 0.15);
    padding: 0.5rem 1rem 0.5rem 0.55rem;
    font-size: 0.9rem;
    transition: all 0.3s var(--ease-soft);
  }
  .chip:not(:has(.fabric, .grid)) {
    padding-left: 1rem;
  }
  .chip:hover {
    border-color: var(--color-leaf);
  }
  .chip:has(input:checked) {
    background: var(--color-leaf);
    border-color: var(--color-leaf);
    color: var(--color-cream);
  }
  .chip:has(input:focus-visible) {
    outline: 2px solid var(--color-gold);
    outline-offset: 3px;
  }
  .step-dot {
    display: grid;
    height: 2rem;
    width: 2rem;
    place-items: center;
    border-radius: 999px;
    background: var(--color-mint);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-leaf);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-builder]');
  if (root) {
    const sizes: Record<string, string[]> = JSON.parse(root.dataset.sizes!);
    const list = root.querySelector('[data-people]')!;
    const tpl = document.querySelector<HTMLTemplateElement>('[data-person-tpl]')!;
    const send = root.querySelector<HTMLAnchorElement>('[data-send]')!;
    const sum = (k: string) => root.querySelector<HTMLElement>(`[data-sum="${k}"]`)!;

    const addPerson = (kind: string) => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      li.dataset.kindValue = kind;
      li.querySelector('[data-kind]')!.textContent = kind;
      const sel = li.querySelector('select')!;
      for (const s of [...sizes[kind], 'Me ajudem']) sel.add(new Option(s === 'Me ajudem' ? 'Me ajudem 🙋' : s, s));
      sel.value = 'Me ajudem';
      li.querySelector('[data-remove]')!.addEventListener('click', () => {
        li.remove();
        update();
      });
      list.appendChild(li);
      update();
    };

    const update = () => {
      const estampa = root.querySelector<HTMLInputElement>('input[name=estampa]:checked')?.value ?? '';
      const modelo = root.querySelector<HTMLInputElement>('input[name=modelo]:checked')?.value ?? '';
      const people = [...list.children].map((li) => {
        const el = li as HTMLElement;
        const size = el.querySelector('select')!.value;
        const name = el.querySelector<HTMLInputElement>('[data-name]')!.value.trim();
        const sizeTxt = size === 'Me ajudem' ? 'tamanho a definir' : `tam. ${size}`;
        return `${el.dataset.kindValue} · ${sizeTxt}${name ? ` (${name})` : ''}`;
      });
      sum('estampa').textContent = estampa;
      sum('modelo').textContent = modelo;
      sum('pecas').innerHTML = people.length
        ? people.map((p) => `<li class="flex gap-2"><span class="text-gold">✦</span>${p.replace(/</g, '&lt;')}</li>`).join('')
        : '<li class="text-cream/60">Adicione quem vai vestir</li>';

      const msg = [
        'Oi! Montei meu pijama pelo site 💚',
        '',
        `Estampa: ${estampa}`,
        `Modelo: ${modelo}`,
        ...(people.length ? ['', 'Peças:', ...people.map((p) => `• ${p}`)] : []),
        '',
        'Pode me passar valores e prazo?',
      ].join('\n');
      send.href = `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(msg)}`;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((b) => b.addEventListener('click', () => addPerson(b.dataset.add!)));
    root.addEventListener('input', update);
    root.addEventListener('change', update);
    addPerson('Criança');

    // cards da seção de estampas pré-selecionam a estampa aqui
    document.querySelectorAll<HTMLElement>('[data-pick]').forEach((a) =>
      a.addEventListener('click', () => {
        const r = root.querySelector<HTMLInputElement>(`input[name=estampa][value="${a.dataset.pick}"]`);
        if (r) r.checked = true;
        update();
      }),
    );
  }
</script>
