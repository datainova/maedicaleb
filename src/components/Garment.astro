---
// Silhueta de peça de pijama preenchida por uma estampa, com pesponto na borda.
interface Props {
  kind: 'top' | 'pants';
  fabric: string;
  class?: string;
  [key: string]: unknown;
}
const { kind, fabric, class: className = '', ...rest } = Astro.props;

const paths = {
  top: 'M70 20 Q100 42 130 20 L172 38 L198 90 L162 104 L152 84 L152 192 L48 192 L48 84 L38 104 L2 90 L28 38 Z',
  pants: 'M38 8 L162 8 L176 192 L116 192 L100 74 L84 192 L24 192 Z',
};
const d = paths[kind];
const mask = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'><path d='${d}'/></svg>`,
)}")`;
---

<div class={`garment ${className}`} {...rest}>
  <div class={`fabric fabric-${fabric} garment-body`} style={`mask-image:${mask};-webkit-mask-image:${mask}`}>
    <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full" aria-hidden="true">
      <path d={d} fill="none" stroke="#fff" stroke-width="5" stroke-dasharray="5 5" opacity="0.9"></path>
      {kind === 'top' && <path d="M100 30 L100 192" stroke="rgb(0 0 0 / .08)" stroke-width="1.2"></path>}
    </svg>
  </div>
</div>

<style>
  .garment {
    filter: drop-shadow(0 22px 28px rgb(29 42 36 / 0.18)) drop-shadow(0 2px 3px rgb(29 42 36 / 0.12));
    aspect-ratio: 1;
  }
  .garment-body {
    position: relative;
    width: 100%;
    height: 100%;
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
  }
</style>
