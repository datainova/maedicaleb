---
interface Props {
  class?: string;
  variant?: 'full' | 'leaf' | 'leaf-cream';
}
const { class: className = '', variant = 'full' } = Astro.props;
const src = { full: '/logo.png', leaf: '/leaf.png', 'leaf-cream': '/leaf-cream.png' }[variant];
const size = variant === 'full' ? { width: 512, height: 512 } : { width: 409, height: 422 };
---

<img src={src} alt={variant === 'full' ? 'Maedicaleb, ateliê infantil' : ''} {...size} class={className} decoding="async" />
